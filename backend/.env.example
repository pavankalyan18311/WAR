# ThreadX Backend Environment Variables
# Copy this file to .env and fill in your values

# App
APP_NAME=ThreadX API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://threadx:threadx_password@localhost:5432/threadx_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# AWS S3 / MinIO
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=threadx-assets
S3_ENDPOINT_URL=  # Leave empty for AWS, set for MinIO

# OpenAI (for chatbot + embeddings)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Payment Gateway (Razorpay)
# Get keys from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_* for testing, rzp_live_* for production
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Set in Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@threadx.com

# MSG91 OTP
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_WIDGET_ID=36666d716e4f313934393138
MSG91_TEMPLATE_ID=your-dlt-approved-template-id
MSG91_DLT_REQUIRED=true
MSG91_VERIFY_SSL=true

# Supabase (for future token verification if needed)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
